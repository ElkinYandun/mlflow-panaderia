name: desperdicio-panaderia

entry_points:
  main:                                  # se ejecuta con: mlflow run .
    parameters:
      n_estimators: {type: int, default: 100}
      max_depth: {type: int, default: 8}
      run_name: {type: string, default: "rf_mlflow"}
    command: "python src/train.py --n-estimators {n_estimators} --max-depth {max_depth} --run-name {run_name}"
